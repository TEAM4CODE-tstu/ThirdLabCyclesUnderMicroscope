<UserControl x:Class="GoodsLogistics.Views.CycleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- Базовые стили текста и полей -->
        <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="BaseTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Стиль кнопок действий -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>

        <!-- Стиль прозрачных кнопок-пресетов -->
        <Style x:Key="TransparentPresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Width" Value="190"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <TextBlock Text="{TemplateBinding Content}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Наведение -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E1F5FE"/>
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <!-- Нажатие -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B3E5FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль ячейки массива: подсветка текущего j -->
        <Style x:Key="CellBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="#FFFACD"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль индикаторов истинности: серый = ещё не проверялось -->
        <Style x:Key="IndicatorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Fill" Value="Gray"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=DataContext.IsInvTrueBefore,
                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="True">
                    <Setter Property="Fill" Value="Green"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=DataContext.IsInvTrueBefore,
                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="False">
                    <Setter Property="Fill" Value="Red"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="LightBlue">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ЧАСТЬ: Режимы и генератор -->
            <Border Grid.Column="0" Padding="12,20,12,12" BorderBrush="LightGray" BorderThickness="0,0,1,0">
                <StackPanel>
                    <TextBlock Text="Режим цикла"
                               Style="{StaticResource BaseTextBlockStyle}"
                               FontWeight="Bold" FontSize="16" Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding SelectedMode.Name, FallbackValue='Ничего не выбрано'}"
                               Style="{StaticResource BaseTextBlockStyle}"
                               FontWeight="SemiBold" Foreground="#555555"
                               Margin="0,0,0,16" VerticalAlignment="Center"/>

                    <ComboBox ItemsSource="{Binding Modes}"
                              SelectedItem="{Binding SelectedMode}"
                              DisplayMemberPath="Name"
                              Height="28" FontSize="13" Margin="0,0,0,16"/>

                    <GroupBox Header="Генератор массива" Padding="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Длина:" Width="50"
                                           Style="{StaticResource BaseTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Length}" Width="60"
                                         Style="{StaticResource BaseTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Мин:" Width="50"
                                           Style="{StaticResource BaseTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                                <TextBox Text="{Binding MinVal}" Width="60"
                                         Style="{StaticResource BaseTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Макс:" Width="50"
                                           Style="{StaticResource BaseTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                                <TextBox Text="{Binding MaxVal}" Width="60"
                                         Style="{StaticResource BaseTextBoxStyle}"/>
                            </StackPanel>
                            <Button Content="Сгенерировать"
                                    Command="{Binding GenerateCommand}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Border>

            <!-- ПРАВАЯ ЧАСТЬ: Входные данные и результаты -->
            <StackPanel Grid.Column="1" Margin="5,0,10,0">

                <TextBlock Text="Массив (редактируемый)"
                           Style="{StaticResource BaseTextBlockStyle}"
                           FontWeight="Bold" FontSize="16" Margin="2,8,0,5"/>
                <TextBox Text="{Binding ArrayInputText, UpdateSourceTrigger=PropertyChanged}"
                         Height="50" TextWrapping="Wrap" Margin="2,0,0,10"
                         Style="{StaticResource BaseTextBoxStyle}"/>

                <TextBlock Text="Порог T (для Count&gt;T)"
                           Style="{StaticResource BaseTextBlockStyle}"
                           FontWeight="Bold" FontSize="16" Margin="2,0,0,5"/>
                <TextBox Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}"
                         Margin="2,0,0,12"
                         Style="{StaticResource BaseTextBoxStyle}"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Сброс" Command="{Binding ResetCommand}"
                            Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="Шаг" Command="{Binding StepCommand}"
                            Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="Пуск (Авто)" Command="{Binding RunCommand}"
                            Style="{StaticResource ActionButtonStyle}"/>

                    <Button Content="Условия корректности"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="ShowConditions_Click"/>
                </StackPanel>

                <TextBlock Text="Массив данных (текущий j подсвечен жёлтым)"
                           Style="{StaticResource BaseTextBlockStyle}"
                           FontWeight="Bold" FontSize="16" Margin="2,0,0,5"/>
                <ItemsControl ItemsSource="{Binding ArrayItems}" Margin="2,0,0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CellBorderStyle}">
                                <TextBlock Text="{Binding Value}"
                                           Width="50" TextAlignment="Center"
                                           FontFamily="Trebuchet MS" FontSize="13"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Блок Инварианта -->
                <Border BorderBrush="Black" BorderThickness="1" Padding="10" Margin="2,0,0,10" Background="White">
                    <StackPanel>
                        <TextBlock Text="Bлок: Инвариант и Вариант"
                                   Style="{StaticResource BaseTextBlockStyle}"
                                   FontWeight="Bold" FontSize="16" Margin="0,0,0,5"/>

                        <TextBlock Text="{Binding SelectedMode.InvariantText}"
                                   FontStyle="Italic" Margin="0,0,0,5"
                                   Style="{StaticResource BaseTextBlockStyle}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedMode.InvariantFormula}"
                                   FontFamily="Consolas" Foreground="Blue" Margin="0,0,0,10"
                                   Style="{StaticResource BaseTextBlockStyle}"
                                   TextWrapping="Wrap"/>

                        <!-- Два индикатора -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Ellipse Style="{StaticResource IndicatorStyle}"/>
                            <TextBlock Text="До шага"
                                       Style="{StaticResource BaseTextBlockStyle}"
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>

                            <Ellipse Width="14" Height="14" Fill="Gray" Margin="0,0,5,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInvTrueAfter}" Value="True">
                                                <Setter Property="Fill" Value="Green"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInvTrueAfter}" Value="False">
                                                <Setter Property="Fill" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="После шага"
                                       Style="{StaticResource BaseTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="{Binding InvStatusText}"
                                   FontWeight="Bold" Margin="0,0,0,5"
                                   Style="{StaticResource BaseTextBlockStyle}"/>

                        <TextBlock Text="Вариант-функция t(j):"
                                   Margin="0,0,0,2"
                                   Style="{StaticResource BaseTextBlockStyle}"/>
                        <ProgressBar Value="{Binding VariantProgress}" Maximum="100"
                                     Height="18" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding VariantStatusText}"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource BaseTextBlockStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Блок WP -->
                <Border BorderBrush="Black" BorderThickness="1" Padding="10" Margin="2,0,0,10" Background="White">
                    <StackPanel>
                        <TextBlock Text="Блок: Проверка сохранения (wp)"
                                   Style="{StaticResource BaseTextBlockStyle}"
                                   FontWeight="Bold" FontSize="16" Margin="0,0,0,5"/>
                        <TextBlock Text="(Inv ∧ B) ⇒ wp(S, Inv)"
                                   FontFamily="Consolas" Foreground="Blue" Margin="0,0,0,5"
                                   Style="{StaticResource BaseTextBlockStyle}"/>
                        <TextBox Text="{Binding WpExplanation}"
                                 TextWrapping="Wrap" FontFamily="Consolas" IsReadOnly="True"
                                 Style="{StaticResource BaseTextBoxStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
